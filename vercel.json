    {
      "source": "/ingestion-latency",
      "destination": "/dashboard/ingestion-latency"
    },
    {
      "source": "/latency-fidelity-enhanced",
      "destination": "/dashboard/latency-fidelity-enhanced"
    },
    {
      "source": "/platform-health",
      "destination": "/dashboard/platform-health"
    },
    {
      "source": "/storage-lifecycle",
      "destination": "/dashboard/storage-lifecycle"
    },
    {
      "source": "/storage-tiers",
      "destination": "/dashboard/storage-tiers"
    },
    {
      "source": "/system-performance",
      "destination": "/dashboard/system-performance"
    },
    {
      "source": "/wildfire-overview",
      "destination": "/dashboard/wildfire-overview"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "trailingSlash": false
}
