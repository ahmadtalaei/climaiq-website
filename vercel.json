{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/fuelmap",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/explorer"
    },
    {
      "source": "/explorer",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/explorer"
    },
    {
      "source": "/aoi/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/aoi/:path*"
    },
    {
      "source": "/utah/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/utah/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/static/:path*"
    },
    {
      "source": "/intelimon/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/intelimon/:path*"
    },
    {
      "source": "/fuels/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/fuels/:path*"
    },
    {
      "source": "/tiles/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/tiles/:path*"
    },
    {
      "source": "/sites",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/sites"
    },
    {
      "source": "/sites/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/sites/:path*"
    },
    {
      "source": "/rasters",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/rasters"
    },
    {
      "source": "/rasters/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/rasters/:path*"
    },
    {
      "source": "/cubes",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/cubes"
    },
    {
      "source": "/cubes/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/cubes/:path*"
    },
    {
      "source": "/fuelmap/sjer",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/explorer/sjer"
    },
    {
      "source": "/fuelmap/utah",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/explorer/utah"
    },
    {
      "source": "/fuelmap/utah/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/explorer/utah/:path*"
    },
    {
      "source": "/explorer/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/explorer/:path*"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://wiley-sherman-retailers-addresses.trycloudflare.com/demo/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "trailingSlash": false
}
