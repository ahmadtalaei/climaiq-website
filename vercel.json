      "destination": "https://encoding-whole-headed-roommates.trycloudflare.com/fuels/:path*"
    },
    {
      "source": "/tiles/:path*",
      "destination": "https://encoding-whole-headed-roommates.trycloudflare.com/tiles/:path*"
    },
    {
      "source": "/sites",
      "destination": "https://encoding-whole-headed-roommates.trycloudflare.com/sites"
    },
    {
      "source": "/sites/:path*",
      "destination": "https://encoding-whole-headed-roommates.trycloudflare.com/sites/:path*"
