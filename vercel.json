      "destination": "/platform/fire-chief"
    },
    {
      "source": "/architecture",
      "destination": "/platform/architecture"
    },
    {
      "source": "/architecture-live",
      "destination": "/platform/architecture-live"
    },
    {
      "source": "/analyst-portal",
      "destination": "/platform/analyst-portal"
    },
    {
      "source": "/scientist-workbench",
      "destination": "/platform/scientist-workbench"
    },
    {
      "source": "/admin-console",
      "destination": "/platform/admin-console"
    },
    {
      "source": "/analytics-platform",
